{
  "manifest_version": 3,
  "name": "YouTube Gemini Summarizer",
  "version": "1.0.0",
  "description": "Extrae transcripciones de videos de YouTube y las envía directamente a Google Gemini Web.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://gemini.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/yt-transcript.js"]
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["src/content/gemini-paste.js"]
    }
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Abrir Resumidor YouTube Gemini",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
